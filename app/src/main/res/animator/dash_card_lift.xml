<?xml version="1.0" encoding="utf-8"?>
<!-- Focused cards lift slightly; resting cards settle back. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <set>
            <objectAnimator android:duration="140" android:interpolator="@android:interpolator/decelerate_cubic"
                android:propertyName="scaleX" android:valueTo="1.04" android:valueType="floatType" />
            <objectAnimator android:duration="140" android:interpolator="@android:interpolator/decelerate_cubic"
                android:propertyName="scaleY" android:valueTo="1.04" android:valueType="floatType" />
            <objectAnimator android:duration="140" android:propertyName="translationZ"
                android:valueTo="8dp" android:valueType="floatType" />
        </set>
    </item>
    <item>
        <set>
            <objectAnimator android:duration="120" android:propertyName="scaleX" android:valueTo="1" android:valueType="floatType" />
            <objectAnimator android:duration="120" android:propertyName="scaleY" android:valueTo="1" android:valueType="floatType" />
            <objectAnimator android:duration="120" android:propertyName="translationZ" android:valueTo="0dp" android:valueType="floatType" />
        </set>
    </item>
</selector>
