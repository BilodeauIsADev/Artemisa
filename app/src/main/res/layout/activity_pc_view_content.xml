<?xml version="1.0" encoding="utf-8"?>
<!-- Home: a spotlight carousel of computers over a blurred wash of their games. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <ImageView
        android:id="@+id/homeBackdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/dash_scrim_spotlight" />

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_marginStart="@dimen/console_screen_horizontal_padding"
        android:layout_marginTop="@dimen/console_screen_vertical_padding"
        android:layout_marginEnd="@dimen/console_screen_horizontal_padding"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="@string/artemisa_brand"
            android:src="@drawable/app_icon" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:fontFamily="@font/albert_sans_semibold"
            android:text="@string/dash_computers"
            android:textColor="@color/dash_text"
            android:textSize="14sp" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/settingsButton"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/console_button_background"
            android:contentDescription="@string/console_settings"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_dash_settings"
            app:tint="@color/dash_text" />

        <ImageButton
            android:id="@+id/helpButton"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="9dp"
            android:background="@drawable/console_button_background"
            android:contentDescription="@string/help"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_dash_help"
            app:tint="@color/dash_text" />

        <ImageButton
            android:id="@+id/profilesButton"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="9dp"
            android:background="@drawable/dash_avatar"
            android:contentDescription="@string/profile_manager_choose_profile"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_dash_user"
            app:tint="@color/dash_on_go" />

        <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:fontFamily="@font/albert_sans_semibold"
            android:fontFeatureSettings="tnum"
            android:textColor="@color/dash_text"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Carousel (SpotlightCarouselView is inflated into this container) -->
    <FrameLayout
        android:id="@+id/pcFragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:layout_marginTop="78dp"
        android:clipChildren="false" />

    <!-- Hero: the focused computer -->
    <LinearLayout
        android:id="@+id/homeHero"
        android:layout_width="760dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="342dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:visibility="invisible">

        <TextView
            android:id="@+id/homeTitle"
            style="@style/DashTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center_horizontal"
            android:maxLines="1"
            android:textSize="32sp"
            tools:text="VaporZPC" />

        <TextView
            android:id="@+id/homeMeta"
            style="@style/DashMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_horizontal"
            tools:text="Online · Paired · 5 games" />
    </LinearLayout>

    <!-- Shown until the first computer turns up -->
    <LinearLayout
        android:id="@+id/no_pc_found_layout"
        android:layout_width="560dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="342dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ProgressBar
            android:id="@+id/pcs_loading"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/dash_go" />

        <TextView
            style="@style/DashTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/dash_searching_title"
            android:textSize="36sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_horizontal"
            android:lineSpacingMultiplier="1.2"
            android:text="@string/dash_searching_message"
            android:textColor="@color/dash_text_2"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- Controller hints -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="31dp"
        android:layout_marginBottom="@dimen/console_screen_vertical_padding"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView style="@style/ArtemisaControllerHintBadge" android:text="@string/console_button_a" />
        <TextView
            android:id="@+id/homeHintPrimary"
            style="@style/ArtemisaControllerHintLabel"
            android:text="@string/dash_open_library" />
        <ImageView
            android:id="@+id/homeHintMenuIcon"
            style="@style/ArtemisaControllerHintIcon"
            android:src="@drawable/ic_dash_menu" />
        <TextView
            android:id="@+id/homeHintMenuLabel"
            style="@style/ArtemisaControllerHintLabel"
            android:text="@string/dash_options" />
    </LinearLayout>

</merge>
