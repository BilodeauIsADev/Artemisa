<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/console_background"
    android:orientation="vertical"
    tools:context=".AppView">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/console_header_height"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/console_screen_horizontal_padding"
        android:paddingEnd="@dimen/console_screen_horizontal_padding">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-condensed"
            android:letterSpacing="0.24"
            android:text="@string/artemisa_brand"
            android:textColor="@color/console_text_primary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <View
            android:layout_width="1dp"
            android:layout_height="30dp"
            android:layout_marginStart="28dp"
            android:layout_marginEnd="28dp"
            android:background="@color/console_border" />

        <TextView
            android:id="@+id/appListText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-condensed"
            android:letterSpacing="0.04"
            android:maxLines="1"
            android:textColor="@color/console_text_primary"
            android:textSize="25sp"
            android:textStyle="bold"
            tools:text="VAPORZ-PC" />

        <TextView
            android:id="@+id/streamProfileText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:background="@drawable/console_card_background"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:letterSpacing="0.04"
            android:minHeight="44dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="@color/console_accent"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="STREAM READY · 3840×2160 · 120 FPS · 150 Mbps" />

        <ImageButton
            android:id="@+id/profilesButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/console_button_background"
            android:contentDescription="@string/profile_manager_choose_profile"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_profiles"
            app:tint="@color/console_text_primary" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/console_screen_horizontal_padding"
        android:paddingEnd="@dimen/console_screen_horizontal_padding">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:fontFamily="sans-serif-condensed"
            android:gravity="center"
            android:letterSpacing="0.08"
            android:text="@string/console_all_games"
            android:textColor="@color/console_accent"
            android:textSize="16sp"
            android:textStyle="bold" />

        <View
            android:layout_width="76dp"
            android:layout_height="3dp"
            android:layout_gravity="bottom"
            android:layout_marginStart="-78dp"
            android:layout_marginBottom="4dp"
            android:background="@color/console_accent" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/appFragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/console_footer_height"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/console_screen_horizontal_padding"
        android:paddingEnd="@dimen/console_screen_horizontal_padding">

        <TextView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/console_controller_badge_green"
            android:gravity="center"
            android:text="@string/console_button_a"
            android:textColor="@color/console_background"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="9dp"
            android:letterSpacing="0.08"
            android:text="@string/console_play"
            android:textColor="@color/console_text_primary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="36dp"
            android:background="@drawable/console_controller_badge_red"
            android:gravity="center"
            android:text="@string/console_button_b"
            android:textColor="@color/console_text_primary"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="9dp"
            android:letterSpacing="0.08"
            android:text="@string/console_back"
            android:textColor="@color/console_text_primary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/console_button_menu"
            android:textColor="@color/console_text_secondary"
            android:textSize="24sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="9dp"
            android:letterSpacing="0.08"
            android:text="@string/console_options"
            android:textColor="@color/console_text_primary"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
