<?xml version="1.0" encoding="utf-8"?>
<!-- Library: a spotlight carousel of covers over the focused game's blurred art,
     with its title and Play centred underneath. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dash_ink"
    tools:context=".AppView">

    <ImageView
        android:id="@+id/libraryBackdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/dash_scrim_spotlight" />

    <View
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:background="@drawable/dash_scrim_top" />

    <!-- Top bar -->
    <include
        layout="@layout/library_top_bar"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_marginStart="@dimen/console_screen_horizontal_padding"
        android:layout_marginTop="@dimen/console_screen_vertical_padding"
        android:layout_marginEnd="@dimen/console_screen_horizontal_padding" />

    <!-- Carousel (SpotlightCarouselView is inflated into this container) -->
    <FrameLayout
        android:id="@+id/appFragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:layout_marginTop="78dp"
        android:clipChildren="false" />

    <!-- Position in the library; hidden for very large libraries -->
    <LinearLayout
        android:id="@+id/libraryDots"
        android:layout_width="wrap_content"
        android:layout_height="5dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="326dp"
        android:orientation="horizontal" />

    <!-- Hero: the focused game -->
    <LinearLayout
        android:id="@+id/libraryHero"
        android:layout_width="760dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="342dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:id="@+id/libraryTitle"
            style="@style/DashTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center_horizontal"
            android:maxLines="1"
            android:textSize="32sp"
            tools:text="Fatal Frame II: Crimson Butterfly Remake" />

        <TextView
            android:id="@+id/libraryMeta"
            style="@style/DashMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:gravity="center_horizontal"
            android:maxLines="1"
            tools:text="4K · 60 FPS · HDR · 80 Mbps" />

        <include
            layout="@layout/library_actions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp" />
    </LinearLayout>

    <!-- Controller hints -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="31dp"
        android:layout_marginBottom="@dimen/console_screen_vertical_padding"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView style="@style/ArtemisaControllerHintBadge" android:text="@string/console_button_a" />
        <TextView style="@style/ArtemisaControllerHintLabel" android:text="@string/dash_play" />
        <ImageView style="@style/ArtemisaControllerHintIcon" android:src="@drawable/ic_dash_menu" />
        <TextView style="@style/ArtemisaControllerHintLabel" android:text="@string/dash_options" />
        <TextView style="@style/ArtemisaControllerHintBadge" android:text="@string/console_button_b" />
        <TextView style="@style/ArtemisaControllerHintLabel" android:text="@string/dash_back" />
    </LinearLayout>

</FrameLayout>
