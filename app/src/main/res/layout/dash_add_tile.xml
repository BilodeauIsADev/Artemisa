<?xml version="1.0" encoding="utf-8"?>
<!-- "Add a computer" tile placed after the computer tiles on Home. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:background="@drawable/console_grid_selector"
    android:clickable="true"
    android:contentDescription="@string/dash_add_computer"
    android:focusable="true"
    android:padding="@dimen/dash_focus_gap">

    <FrameLayout
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:background="@drawable/dash_host_pill">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_dash_plus"
            app:tint="@color/dash_text_2" />
    </FrameLayout>
</FrameLayout>
