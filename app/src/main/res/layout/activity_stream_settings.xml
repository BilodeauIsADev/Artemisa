<?xml version="1.0" encoding="utf-8"?>
<!-- Settings: categories on the left, the selected category's options on the right. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dash_surface_1">

    <TextView
        style="@style/DashTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/console_screen_horizontal_padding"
        android:layout_marginTop="@dimen/console_screen_vertical_padding"
        android:text="@string/console_settings"
        android:textSize="26sp" />

    <LinearLayout
        android:layout_width="230dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/console_screen_horizontal_padding"
        android:layout_marginTop="85dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/settingsTabStream"
            style="@style/ArtemisaSettingsTab"
            android:drawableStart="@drawable/ic_dash_settings_film"
            android:text="@string/dash_settings_video" />

        <TextView
            android:id="@+id/settingsTabAudio"
            style="@style/ArtemisaSettingsTab"
            android:drawableStart="@drawable/ic_dash_settings_speaker"
            android:text="@string/dash_settings_audio_host" />

        <TextView
            android:id="@+id/settingsTabControls"
            style="@style/ArtemisaSettingsTab"
            android:drawableStart="@drawable/ic_dash_settings_gamepad"
            android:text="@string/dash_settings_controller" />

        <TextView
            android:id="@+id/settingsTabOverlay"
            style="@style/ArtemisaSettingsTab"
            android:drawableStart="@drawable/ic_dash_settings_chart"
            android:text="@string/dash_settings_overlay" />

        <TextView
            android:id="@+id/settingsTabAppearance"
            style="@style/ArtemisaSettingsTab"
            android:drawableStart="@drawable/ic_dash_settings_grid"
            android:text="@string/dash_settings_library" />

        <TextView
            android:id="@+id/settingsTabSystem"
            style="@style/ArtemisaSettingsTab"
            android:drawableStart="@drawable/ic_dash_settings_globe"
            android:text="@string/dash_settings_system" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="310dp"
        android:layout_marginTop="80dp"
        android:layout_marginEnd="@dimen/console_screen_horizontal_padding"
        android:layout_marginBottom="58dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/settingsSectionDescription"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:layout_marginBottom="10dp"
            android:fontFamily="@font/albert_sans_bold"
            android:textColor="@color/dash_text"
            android:textSize="17sp" />

        <FrameLayout
            android:id="@+id/stream_settings"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/console_panel_background"
            android:clipToOutline="true"
            android:padding="6dp" />
    </LinearLayout>

    <!-- Controller hints -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="31dp"
        android:layout_marginBottom="@dimen/console_screen_vertical_padding"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView style="@style/ArtemisaControllerHintPill" android:text="@string/console_button_lb" />
        <TextView style="@style/ArtemisaControllerHintPill" android:layout_marginStart="4dp" android:text="@string/console_button_rb" />
        <TextView style="@style/ArtemisaControllerHintLabel" android:text="@string/dash_change_section" />
        <TextView style="@style/ArtemisaControllerHintBadge" android:text="@string/console_button_a" />
        <TextView style="@style/ArtemisaControllerHintLabel" android:text="@string/dash_select" />
        <TextView style="@style/ArtemisaControllerHintBadge" android:text="@string/console_button_b" />
        <TextView
            style="@style/ArtemisaControllerHintLabel"
            android:text="@string/dash_back" />
    </LinearLayout>

</FrameLayout>
