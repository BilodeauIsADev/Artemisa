<?xml version="1.0" encoding="utf-8"?>
<!-- Library top bar: app icon, host pill, then settings, profile and clock. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="32dp"
    android:layout_marginStart="@dimen/console_screen_horizontal_padding"
    android:layout_marginTop="@dimen/console_screen_vertical_padding"
    android:layout_marginEnd="@dimen/console_screen_horizontal_padding"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:contentDescription="@string/artemisa_brand"
        android:src="@drawable/app_icon" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:layout_marginStart="14dp"
        android:background="@drawable/dash_host_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="12dp">

        <ImageView
            android:layout_width="13dp"
            android:layout_height="13dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_dash_monitor"
            app:tint="@color/dash_text" />

        <TextView
            android:id="@+id/appListText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:ellipsize="end"
            android:fontFamily="@font/albert_sans_semibold"
            android:maxLines="1"
            android:maxWidth="260dp"
            android:textColor="@color/dash_text"
            android:textSize="13sp"
            tools:text="VaporZPC" />
    </LinearLayout>

    <Space
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_weight="1" />

    <ImageButton
        android:id="@+id/settingsButton"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:background="@drawable/console_button_background"
        android:contentDescription="@string/console_settings"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_dash_settings"
        app:tint="@color/dash_text" />

    <ImageButton
        android:id="@+id/profilesButton"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginStart="9dp"
        android:background="@drawable/dash_avatar"
        android:contentDescription="@string/profile_manager_choose_profile"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_dash_user"
        app:tint="@color/dash_on_go" />

    <TextClock
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:fontFamily="@font/albert_sans_semibold"
        android:fontFeatureSettings="tnum"
        android:textColor="@color/dash_text"
        android:textSize="14sp" />
</LinearLayout>
