<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="490dp"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="36dp"
    android:paddingTop="32dp"
    android:paddingEnd="36dp"
    android:paddingBottom="8dp">

    <ImageView
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_dash_lock"
        app:tint="@color/dash_go" />

    <TextView
        android:id="@+id/pairTitle"
        style="@style/DashTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:textSize="26sp" />

    <TextView
        android:id="@+id/pairMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:textColor="@color/dash_text_2"
        android:textSize="15sp" />

    <LinearLayout
        android:id="@+id/pairPinDigits"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:importantForAccessibility="yes"
        android:orientation="horizontal" />

    <TextView
        android:id="@+id/pairHelp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:textColor="@color/dash_text_3"
        android:textSize="13sp" />
</LinearLayout>
