<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="38dp"
    android:background="@drawable/console_menu_row_background"
    android:clickable="true"
    android:focusable="true"
    android:focusableInTouchMode="false"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="11dp"
    android:paddingEnd="11dp">

    <ImageView
        android:id="@+id/consoleMenuItemIcon"
        android:layout_width="15dp"
        android:layout_height="15dp"
        android:duplicateParentState="true"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        app:tint="@color/dash_on_focus_text_2" />

    <TextView
        android:id="@+id/consoleMenuItemLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:duplicateParentState="true"
        android:ellipsize="end"
        android:fontFamily="@font/albert_sans_medium"
        android:maxLines="1"
        android:textColor="@color/dash_on_focus_text"
        android:textSize="14sp" />

    <ImageView
        android:id="@+id/consoleMenuItemCheck"
        android:layout_width="15dp"
        android:layout_height="15dp"
        android:duplicateParentState="true"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_dash_check"
        android:visibility="gone"
        app:tint="@color/dash_on_focus_text" />
</LinearLayout>
