<?xml version="1.0" encoding="utf-8"?>
<!-- Title list row: a small cover and the game's name; the highlighted row turns white. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="46dp"
    android:background="@drawable/dash_list_row_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="13dp"
    android:paddingEnd="14dp">

    <androidx.cardview.widget.CardView
        android:layout_width="23dp"
        android:layout_height="31dp"
        app:cardBackgroundColor="@color/dash_surface_3"
        app:cardCornerRadius="3dp"
        app:cardElevation="0dp">

        <ImageView
            android:id="@+id/grid_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/dash_desktop_tile"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />

        <!-- Name fallback for missing art; the row's title already shows the name -->
        <TextView
            android:id="@+id/grid_text"
            android:layout_width="0dp"
            android:layout_height="0dp" />
    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/app_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="11dp"
        android:layout_weight="1"
        android:duplicateParentState="true"
        android:ellipsize="end"
        android:fontFamily="@font/albert_sans_bold"
        android:maxLines="1"
        android:textColor="@color/dash_list_row_text"
        android:textSize="18sp" />

    <ImageView
        android:id="@+id/grid_overlay"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="10dp"
        android:background="@drawable/console_controller_badge_green"
        android:contentDescription="@string/applist_menu_resume"
        android:padding="5dp"
        android:visibility="gone"
        app:tint="@color/dash_ink" />
</LinearLayout>
