<?xml version="1.0" encoding="utf-8"?>
<!-- Library tile: portrait cover. Size is set by SpotlightCarouselView. -->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/dash_spotlight_width"
    android:layout_height="@dimen/dash_spotlight_height"
    app:cardBackgroundColor="@color/dash_surface_3"
    app:cardCornerRadius="10dp"
    app:cardElevation="6dp"
    app:cardPreventCornerOverlap="false"
    app:cardUseCompatPadding="false">

    <ImageView
        android:id="@+id/grid_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/dash_desktop_tile"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <RelativeLayout
        android:id="@+id/grid_mask"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <TextView
            android:id="@+id/grid_text"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:ellipsize="end"
            android:fontFamily="@font/albert_sans_bold"
            android:gravity="center"
            android:maxLines="4"
            android:padding="7dp"
            android:textColor="@color/dash_text"
            android:textSize="11sp" />

        <ImageView
            android:id="@+id/grid_overlay"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:layout_margin="5dp"
            android:background="@drawable/console_controller_badge_green"
            android:contentDescription="@string/applist_menu_resume"
            android:padding="5dp"
            android:visibility="gone"
            app:tint="@color/dash_ink" />
    </RelativeLayout>

</androidx.cardview.widget.CardView>
