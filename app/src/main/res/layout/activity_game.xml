<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Game" >

    <View
        android:id="@+id/backgroundTouchView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center" />
    
    <com.limelight.ui.StreamContainer
        android:id="@+id/streamContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:defaultFocusHighlightEnabled="false"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:focusedByDefault="true">
    <requestFocus />
    </com.limelight.ui.StreamContainer>

<!--    <com.limelight.ui.ApertureViewGroup-->
<!--        android:layout_width="match_parent"-->
<!--        android:layout_height="match_parent"-->
<!--        app:aperture_color1="#5CF950"-->
<!--        android:layout_gravity="center"-->
<!--        android:padding="5dp"-->
<!--        app:aperture_color2="#FC9595"-->
<!--        app:aperture_border_width="10dp"-->
<!--        app:aperture_border_angle="24dp"-->
<!--        app:aperture_duration="6000"-->
<!--        app:aperture_middle_color="#6CD2F8">-->
<!--    </com.limelight.ui.ApertureViewGroup>-->

    <TextView
        android:id="@+id/notificationOverlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginTop="10dp"
        android:layout_gravity="right"
        android:textAppearance="?android:attr/textAppearanceLarge"
        android:gravity="right"
        android:background="#80000000"
        android:preferKeepClear="true"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/performanceOverlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:visibility="gone">

        <TextView
            android:id="@+id/performanceOverlayBig"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_marginStart="@dimen/console_screen_horizontal_padding"
            android:layout_marginTop="@dimen/console_screen_vertical_padding"
            android:background="@drawable/console_performance_panel"
            android:fontFamily="@font/albert_sans"
            android:fontFeatureSettings="tnum"
            android:gravity="start"
            android:lineSpacingMultiplier="1.25"
            android:paddingStart="14dp"
            android:paddingTop="11dp"
            android:paddingEnd="14dp"
            android:paddingBottom="11dp"
            android:textColor="@color/dash_text"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/performanceOverlayLite"
            tools:text="59.9 FPS  |  2 ms network  |  4.1 ms decode"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="@dimen/console_screen_vertical_padding"
            android:layout_marginEnd="@dimen/console_screen_horizontal_padding"
            android:background="@drawable/console_performance_bar"
            android:ellipsize="end"
            android:fontFamily="@font/albert_sans"
            android:fontFeatureSettings="tnum"
            android:gravity="center"
            android:maxLines="1"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:preferKeepClear="true"
            android:textColor="@color/dash_text"
            android:textSize="12sp"
            android:visibility="gone" />

    </FrameLayout>

    <!-- Floating Menu Button -->
    <ImageButton
        android:id="@+id/floatingMenuButton"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="top|start"
        android:layout_marginTop="24dp"
        android:background="@drawable/floating_menu_button"
        android:contentDescription="@string/menu_button"
        android:src="@drawable/ic_menu"
        android:padding="6dp"
        android:visibility="gone"
        android:elevation="9999dp" />

    <ImageButton
        android:id="@+id/overlayToggleZoomButton"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="24dp"
        android:background="@drawable/floating_menu_button"
        android:src="@drawable/ic_zoom_toggle"
        android:padding="6dp"
        android:scaleType="fitCenter"
        android:contentDescription="@string/toggle_pan_zoom_mode"
        android:visibility="gone"
        android:elevation="9999dp" />

    <!-- Launch screen: the game's art while the stream comes up -->
    <FrameLayout
        android:id="@+id/connectionOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/dash_ink"
        android:clickable="true"
        android:elevation="10000dp"
        android:focusable="false"
        android:importantForAccessibility="yes">

        <ImageView
            android:id="@+id/connectionBackdrop"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="84dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="@dimen/console_screen_horizontal_padding"
            android:paddingEnd="@dimen/console_screen_horizontal_padding">

            <androidx.cardview.widget.CardView
                android:id="@+id/connectionCoverCard"
                android:layout_width="90dp"
                android:layout_height="135dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/dash_surface_3"
                app:cardCornerRadius="9dp"
                app:cardElevation="14dp">

                <ImageView
                    android:id="@+id/connectionCover"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop" />
            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/connectionAppName"
                style="@style/DashTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="2"
                android:text="@string/artemisa_brand"
                android:textSize="28sp" />

            <TextView
                android:id="@+id/connectionComputerName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:ellipsize="end"
                android:fontFamily="@font/albert_sans_medium"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="@color/dash_text_2"
                android:textSize="14sp" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/connectionProgress"
                android:layout_width="260dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:indeterminate="true"
                app:indicatorColor="@color/dash_go"
                app:trackColor="@color/dash_glass_strong"
                app:indicatorTrackGapSize="0dp"
                app:trackCornerRadius="3dp"
                app:trackStopIndicatorSize="0dp"
                app:trackThickness="6dp" />

            <TextView
                android:id="@+id/connectionStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/albert_sans"
                android:gravity="center"
                android:text="@string/console_preparing_stream"
                android:textColor="@color/dash_text_3"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="31dp"
            android:layout_marginBottom="@dimen/console_screen_vertical_padding"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView style="@style/ArtemisaControllerHintBadge" android:text="@string/console_button_b" />
            <TextView style="@style/ArtemisaControllerHintLabel" android:text="@string/dash_cancel" />
        </LinearLayout>
    </FrameLayout>

</merge>
