<?xml version="1.0" encoding="utf-8"?>
<!-- Quick menu card: icon, label, current state. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/gameMenuOption"
    android:layout_width="0dp"
    android:layout_height="98dp"
    android:layout_weight="1"
    android:background="@drawable/dash_card_background"
    android:clickable="true"
    android:focusable="true"
    android:focusableInTouchMode="false"
    android:orientation="vertical"
    android:padding="13dp"
    android:soundEffectsEnabled="true"
    android:stateListAnimator="@animator/dash_card_lift">

    <ImageView
        android:id="@+id/gameMenuOptionIcon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        app:tint="@color/dash_text" />

    <Space
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/gameMenuOptionLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="@font/albert_sans_bold"
        android:maxLines="1"
        android:textColor="@color/dash_text"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/gameMenuOptionStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:fontFamily="@font/albert_sans_medium"
        android:maxLines="1"
        android:textColor="@color/dash_text_2"
        android:textSize="11sp" />
</LinearLayout>
