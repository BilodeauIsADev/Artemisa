<?xml version="1.0" encoding="utf-8"?>
<!-- Play (or Resume) and the round options button for the focused game. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <LinearLayout
        android:id="@+id/libraryPlayButton"
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:background="@drawable/dash_pill_primary"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="25dp"
        android:paddingEnd="30dp">

        <ImageView
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_dash_play"
            app:tint="@color/dash_ink" />

        <TextView
            android:id="@+id/libraryPlayLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="@font/albert_sans_bold"
            android:text="@string/dash_play"
            android:textColor="@color/dash_ink"
            android:textSize="16sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/libraryMoreButton"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginStart="3dp"
        android:background="@drawable/dash_circle_button"
        android:contentDescription="@string/dash_more_options"
        android:padding="20dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_dash_more"
        app:tint="@color/dash_text" />
</LinearLayout>
