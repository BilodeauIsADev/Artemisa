<?xml version="1.0" encoding="utf-8"?>
<!-- Computer tile: a rounded square with a monitor glyph and a state badge. -->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="80dp"
    android:layout_height="80dp"
    app:cardBackgroundColor="@color/dash_glass_strong"
    app:cardCornerRadius="11dp"
    app:cardElevation="0dp"
    app:cardPreventCornerOverlap="false"
    app:cardUseCompatPadding="false">

    <ImageView
        android:id="@+id/grid_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:padding="22dp"
        android:scaleType="fitCenter"
        app:tint="@color/dash_text" />

    <RelativeLayout
        android:id="@+id/grid_mask"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/grid_overlay"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:layout_margin="6dp"
            android:background="@drawable/console_controller_badge_green"
            android:contentDescription="@null"
            android:padding="4dp"
            android:visibility="gone"
            app:tint="@color/dash_ink" />

        <ProgressBar
            android:id="@+id/grid_spinner"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:layout_margin="7dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/dash_text" />

        <TextView
            android:id="@+id/grid_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />
    </RelativeLayout>

</androidx.cardview.widget.CardView>
