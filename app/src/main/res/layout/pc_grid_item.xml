<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="400dp"
    android:layout_height="210dp"
    android:layout_margin="10dp"
    android:background="@drawable/console_card_background"
    android:padding="26dp">

    <RelativeLayout
        android:id="@+id/grid_image_layout"
        android:layout_width="126dp"
        android:layout_height="match_parent"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:gravity="center">

        <ImageView
            android:id="@+id/grid_image"
            android:layout_width="112dp"
            android:layout_height="112dp"
            android:layout_centerInParent="true"
            android:contentDescription="@null"
            app:tint="@color/console_text_primary" />

        <ImageView
            android:id="@+id/grid_overlay"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_centerInParent="true"
            android:contentDescription="@null" />

        <ProgressBar
            android:id="@+id/grid_spinner"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_centerInParent="true"
            android:indeterminate="true"
            android:indeterminateTint="@color/console_accent" />
    </RelativeLayout>

    <TextView
        android:id="@+id/grid_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginStart="24dp"
        android:layout_toEndOf="@id/grid_image_layout"
        android:ellipsize="end"
        android:fontFamily="sans-serif-condensed"
        android:letterSpacing="0.03"
        android:maxLines="2"
        android:textColor="@color/console_text_primary"
        android:textSize="28sp"
        android:textStyle="bold" />

    <View
        android:id="@+id/grid_status_dot"
        android:layout_width="9dp"
        android:layout_height="9dp"
        android:layout_alignStart="@id/grid_text"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="26dp"
        android:background="@drawable/console_controller_badge_green" />

    <TextView
        android:id="@+id/grid_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_alignStart="@id/grid_text"
        android:layout_marginStart="17dp"
        android:layout_marginBottom="20dp"
        android:fontFamily="sans-serif"
        android:letterSpacing="0.06"
        android:text="@string/console_stream_ready"
        android:textColor="@color/console_accent"
        android:textSize="13sp"
        android:textStyle="bold" />

</RelativeLayout>
