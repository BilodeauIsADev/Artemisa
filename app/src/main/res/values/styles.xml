<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        Base application theme, dependent on API level. This theme is replaced
        by AppBaseTheme from res/values-vXX/styles.xml on newer devices.

    -->
    <style name="AppBaseTheme" parent="Theme.MaterialComponents.NoActionBar">
        <!--
            Theme customizations available in newer API levels can go in
            res/values-vXX/styles.xml, while customizations related to
            backward-compatibility can go here.
        -->
    </style>

    <!-- Application theme. -->
    <style name="AppTheme" parent="AppBaseTheme">
        <!-- All customizations that are NOT specific to a particular API-level can go here. -->
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:statusBarColor">@color/console_background</item>
        <item name="android:navigationBarColor">@color/console_background</item>
        <item name="android:colorBackground">@color/console_background</item>
        <item name="android:windowBackground">@color/console_background</item>
        <item name="android:fontFamily">@font/albert_sans</item>
        <item name="android:colorAccent">@color/console_accent</item>
        <item name="colorAccent">@color/console_accent</item>
        <item name="colorPrimary">@color/dash_go</item>
        <item name="colorOnPrimary">@color/dash_on_go</item>
        <item name="colorSurface">@color/dash_surface_2</item>
        <item name="colorOnSurface">@color/dash_text</item>
        <item name="android:textColorPrimary">@color/dash_text</item>
        <item name="android:textColorSecondary">@color/dash_text_2</item>
        <item name="android:alertDialogTheme">@style/ArtemisaDialogTheme</item>
        <item name="alertDialogTheme">@style/ArtemisaDialogTheme</item>
        <item name="materialAlertDialogTheme">@style/ArtemisaDialogTheme</item>
    </style>

    <style name="ArtemisaDialogTheme" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="android:windowBackground">@drawable/console_panel_background</item>
        <item name="android:colorAccent">@color/console_accent</item>
        <item name="colorAccent">@color/console_accent</item>
        <item name="colorPrimary">@color/console_accent</item>
        <item name="colorSurface">@color/console_surface</item>
        <item name="colorOnSurface">@color/console_text_primary</item>
        <item name="android:textColorPrimary">@color/console_text_primary</item>
        <item name="android:textColorSecondary">@color/console_text_secondary</item>
        <item name="android:fontFamily">@font/albert_sans</item>
        <item name="android:backgroundDimAmount">0.6</item>
        <item name="buttonBarPositiveButtonStyle">@style/ArtemisaDialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/ArtemisaDialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/ArtemisaDialogButton</item>
        <item name="materialAlertDialogTitleTextStyle">@style/ArtemisaDialogTitle</item>
        <item name="android:buttonBarButtonStyle">@style/ArtemisaDialogButtonFramework</item>
        <item name="android:windowTitleStyle">@style/ArtemisaDialogWindowTitle</item>
    </style>

    <!-- Buttons of framework AlertDialogs (android.app.AlertDialog) -->
    <style name="ArtemisaDialogButtonFramework" parent="@android:style/Widget.Material.Button.Borderless">
        <item name="android:background">@drawable/dash_dialog_button_background</item>
        <item name="android:textColor">@color/dash_dialog_button_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">@font/albert_sans_bold</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">72dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:backgroundTint">@null</item>
        <item name="backgroundTint">@null</item>
    </style>

    <style name="ArtemisaDialogWindowTitle" parent="@android:style/TextAppearance.Material.Title">
        <item name="android:fontFamily">@font/albert_sans_extrabold</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">@color/dash_text</item>
    </style>

    <style name="ArtemisaDialogTitle" parent="MaterialAlertDialog.MaterialComponents.Title.Text">
        <item name="android:textAppearance">@style/ArtemisaDialogTitleText</item>
    </style>

    <style name="ArtemisaDialogTitleText" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:fontFamily">@font/albert_sans_extrabold</item>
        <item name="fontFamily">@font/albert_sans_extrabold</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">@color/dash_text</item>
    </style>

    <style name="ArtemisaDialogButton" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/dash_dialog_button_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@font/albert_sans_bold</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="backgroundTint">@color/dash_dialog_button_bg</item>
        <item name="rippleColor">@android:color/transparent</item>
        <item name="shapeAppearance">@style/ArtemisaPillShape</item>
    </style>

    <style name="ArtemisaPillShape">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="StreamBaseTheme" parent="AppBaseTheme">
        <!-- Transparent streaming background to avoid extra overdraw -->
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>

    <!-- Stream activity theme -->
    <style name="StreamTheme" parent="StreamBaseTheme">
        <!-- All customizations that are NOT specific to a particular API-level can go here. -->
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <!-- Added for API 34+ where ImageButton requires these color attrs to inflate -->
        <item name="android:colorControlNormal">@android:color/white</item>
        <item name="android:colorControlHighlight">@android:color/white</item>
        <item name="android:colorAccent">@android:color/white</item>
        <item name="android:colorControlActivated">@android:color/white</item>
        <item name="android:colorButtonNormal">@android:color/white</item>
        <!-- Duplicate non-prefixed color attributes for AppCompat widgets -->
        <item name="colorControlNormal">@android:color/white</item>
        <item name="colorControlHighlight">@android:color/white</item>
        <item name="colorAccent">@android:color/white</item>
        <item name="colorControlActivated">@android:color/white</item>
        <item name="colorButtonNormal">@android:color/white</item>
        <item name="android:alertDialogTheme">@style/ArtemisaDialogTheme</item>
        <item name="alertDialogTheme">@style/ArtemisaDialogTheme</item>
        <item name="materialAlertDialogTheme">@style/ArtemisaDialogTheme</item>
    </style>

    <style name="SettingsTheme" parent="AppTheme">
        <item name="android:statusBarColor">@color/console_background</item>
        <item name="android:navigationBarColor">@color/console_background</item>
        <item name="android:colorBackground">@color/console_background</item>
        <item name="android:windowBackground">@color/console_background</item>
        <item name="android:textColorPrimary">@color/console_text_primary</item>
        <item name="android:textColorSecondary">@color/console_text_secondary</item>
        <item name="android:colorControlActivated">@color/console_accent</item>
        <item name="colorControlActivated">@color/console_accent</item>
        <item name="android:selectableItemBackground">@drawable/console_preference_row_background</item>
        <item name="android:textAppearanceListItem">@style/DashPreferenceTitle</item>
        <item name="android:textAppearanceSmall">@style/DashPreferenceSummary</item>
        <item name="preferenceCategoryTitleTextAppearance">@style/DashPreferenceCategory</item>
        <item name="preferenceCategoryTitleTextColor">@color/dash_text_3</item>
        <item name="colorSwitchThumbNormal">#9AA0A8</item>
        <item name="preferenceTheme">@style/DashPreferenceTheme</item>
        <item name="switchStyle">@style/DashSwitch</item>
    </style>

    <!-- Settings switches: green track when on, dark thumb; neutral when off -->
    <style name="DashSwitch" parent="Widget.AppCompat.CompoundButton.Switch">
        <item name="thumbTint">@color/dash_switch_thumb</item>
        <item name="trackTint">@color/dash_switch_track</item>
        <item name="trackTintMode">src_in</item>
    </style>

    <style name="DashPreferenceTheme" parent="PreferenceThemeOverlay">
        <item name="preferenceStyle">@style/DashPreference</item>
        <item name="dialogPreferenceStyle">@style/DashPreference.Dialog</item>
        <item name="editTextPreferenceStyle">@style/DashPreference.EditText</item>
        <item name="switchPreferenceCompatStyle">@style/DashPreference.Switch</item>
        <item name="checkBoxPreferenceStyle">@style/DashPreference.CheckBox</item>
        <item name="preferenceCategoryStyle">@style/DashPreference.Category</item>
    </style>

    <style name="DashPreference" parent="Preference.Material">
        <item name="android:layout">@layout/dash_preference</item>
        <item name="iconSpaceReserved">false</item>
        <item name="allowDividerAbove">true</item>
        <item name="allowDividerBelow">true</item>
    </style>

    <style name="DashPreference.Dialog" parent="Preference.DialogPreference.Material">
        <item name="android:layout">@layout/dash_preference</item>
        <item name="iconSpaceReserved">false</item>
        <item name="allowDividerAbove">true</item>
        <item name="allowDividerBelow">true</item>
    </style>

    <style name="DashPreference.EditText" parent="Preference.DialogPreference.EditTextPreference.Material">
        <item name="android:layout">@layout/dash_preference</item>
        <item name="iconSpaceReserved">false</item>
        <item name="allowDividerAbove">true</item>
        <item name="allowDividerBelow">true</item>
    </style>

    <style name="DashPreference.Switch" parent="Preference.SwitchPreferenceCompat.Material">
        <item name="android:layout">@layout/dash_preference</item>
        <item name="iconSpaceReserved">false</item>
        <item name="allowDividerAbove">true</item>
        <item name="allowDividerBelow">true</item>
    </style>

    <style name="DashPreference.CheckBox" parent="Preference.CheckBoxPreference.Material">
        <item name="android:layout">@layout/dash_preference</item>
        <item name="iconSpaceReserved">false</item>
        <item name="allowDividerAbove">true</item>
        <item name="allowDividerBelow">true</item>
    </style>

    <style name="DashPreference.Category" parent="Preference.Category.Material">
        <item name="android:layout">@layout/dash_preference_category</item>
        <item name="iconSpaceReserved">false</item>
        <item name="allowDividerAbove">true</item>
        <item name="allowDividerBelow">true</item>
    </style>

    <style name="DashPreferenceTitle" parent="TextAppearance.AppCompat.Subhead">
        <item name="android:fontFamily">@font/albert_sans_semibold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/dash_text</item>
    </style>

    <style name="DashPreferenceSummary" parent="TextAppearance.AppCompat.Small">
        <item name="android:fontFamily">@font/albert_sans</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/dash_text_2</item>
    </style>

    <style name="DashPreferenceCategory" parent="TextAppearance.AppCompat.Body2">
        <item name="android:fontFamily">@font/albert_sans_bold</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/dash_text_3</item>
    </style>

    <style name="ArtemisaSettingsTab">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">34dp</item>
        <item name="android:layout_marginEnd">2dp</item>
        <item name="android:background">@drawable/dash_tab_background</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:focusableInTouchMode">false</item>
        <item name="android:fontFamily">@font/albert_sans_bold</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textColor">@color/dash_tab_text</item>
        <item name="android:textSize">15sp</item>
    </style>

    <!-- Controller hint: white disc with the button letter, then a label -->
    <style name="ArtemisaControllerHintBadge">
        <item name="android:layout_width">20dp</item>
        <item name="android:layout_height">20dp</item>
        <item name="android:background">@drawable/console_controller_badge_green</item>
        <item name="android:fontFamily">@font/albert_sans_extrabold</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/dash_ink</item>
        <item name="android:textSize">10sp</item>
    </style>

    <style name="ArtemisaControllerHintPill" parent="ArtemisaControllerHintBadge">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:minWidth">26dp</item>
        <item name="android:paddingStart">6dp</item>
        <item name="android:paddingEnd">6dp</item>
        <item name="android:background">@drawable/dash_hint_pill</item>
        <item name="android:textSize">9sp</item>
    </style>

    <style name="ArtemisaControllerHintIcon">
        <item name="android:layout_width">20dp</item>
        <item name="android:layout_height">20dp</item>
        <item name="android:background">@drawable/console_controller_badge_green</item>
        <item name="android:padding">4dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="tint">@color/dash_ink</item>
    </style>

    <style name="ArtemisaControllerHintLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">6dp</item>
        <item name="android:layout_marginEnd">17dp</item>
        <item name="android:fontFamily">@font/albert_sans_semibold</item>
        <item name="android:textColor">@color/dash_text_2</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="DashKeyboardSegment">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">26dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">13dp</item>
        <item name="android:paddingEnd">13dp</item>
        <item name="android:fontFamily">@font/albert_sans_semibold</item>
        <item name="android:textColor">@color/dash_text_2</item>
        <item name="android:textSize">12sp</item>
    </style>

    <!-- Dashboard type roles -->
    <style name="DashTitle">
        <item name="android:fontFamily">@font/albert_sans_extrabold</item>
        <item name="android:textColor">@color/dash_text</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="DashMeta">
        <item name="android:fontFamily">@font/albert_sans_medium</item>
        <item name="android:textColor">@color/dash_text_2</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>

    <style name="ExternalDisplayControllerTheme" parent="AppTheme">
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
        <item name="android:windowBackground">@android:color/black</item>
    </style>

    <declare-styleable name="ApertureViewGroup">
        <attr name="aperture_color1" format="color" />
        <attr name="aperture_color2" format="color" />
        <attr name="aperture_border_width" format="dimension" />
        <attr name="aperture_border_angle" format="dimension" />
        <attr name="aperture_duration" format="integer" />
        <attr name="aperture_middle_color" format="color" />
    </declare-styleable>

</resources>
