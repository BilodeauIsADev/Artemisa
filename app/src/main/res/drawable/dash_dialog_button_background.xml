<?xml version="1.0" encoding="utf-8"?>
<!-- Dialog buttons: glass pill at rest, green pill when focused. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <inset android:insetTop="4dp" android:insetBottom="4dp">
            <shape android:shape="rectangle"><solid android:color="@color/dash_go" /><corners android:radius="20dp" /></shape>
        </inset>
    </item>
    <item android:state_pressed="true">
        <inset android:insetTop="4dp" android:insetBottom="4dp">
            <shape android:shape="rectangle"><solid android:color="@color/dash_go" /><corners android:radius="20dp" /></shape>
        </inset>
    </item>
    <item>
        <inset android:insetTop="4dp" android:insetBottom="4dp">
            <shape android:shape="rectangle"><solid android:color="@color/dash_glass" /><corners android:radius="20dp" /></shape>
        </inset>
    </item>
</selector>
