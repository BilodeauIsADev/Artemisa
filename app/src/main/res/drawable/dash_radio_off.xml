<?xml version="1.0" encoding="utf-8"?>
<!-- Unchosen option in a settings list: a ring, dark on a focused (green) row. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true"><shape android:shape="oval"><size android:width="14dp" android:height="14dp" /><solid android:color="@android:color/transparent" /><stroke android:width="2dp" android:color="#B30A1200" /></shape></item>
    <item><shape android:shape="oval"><size android:width="14dp" android:height="14dp" /><solid android:color="@android:color/transparent" /><stroke android:width="2dp" android:color="#66FFFFFF" /></shape></item>
</selector>
