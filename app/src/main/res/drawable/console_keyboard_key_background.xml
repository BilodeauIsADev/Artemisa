<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="#5976D600" />
            <corners android:radius="6dp" />
            <stroke android:width="3dp" android:color="@color/console_accent" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#4076D600" />
            <corners android:radius="6dp" />
            <stroke android:width="3dp" android:color="@color/console_accent" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/console_accent_soft" />
            <corners android:radius="6dp" />
            <stroke android:width="3dp" android:color="@color/console_accent" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="#3376D600" />
            <corners android:radius="6dp" />
            <stroke android:width="2dp" android:color="@color/console_accent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1A221C" />
            <corners android:radius="6dp" />
            <stroke android:width="1dp" android:color="@color/console_border" />
        </shape>
    </item>
</selector>
