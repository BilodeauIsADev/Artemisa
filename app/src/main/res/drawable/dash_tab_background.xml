<?xml version="1.0" encoding="utf-8"?>
<!-- Settings section tab: a green-ringed pill when focused, a white underline when selected. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true"><shape android:shape="rectangle"><solid android:color="@color/dash_glass_strong" /><corners android:radius="17dp" /><stroke android:width="3dp" android:color="@color/dash_go" /></shape></item>
    <item android:state_selected="true"><layer-list><item android:bottom="1dp" android:left="12dp" android:right="12dp" android:top="30dp"><shape android:shape="rectangle"><solid android:color="@color/dash_text" /><corners android:radius="2dp" /></shape></item></layer-list></item>
    <item><shape android:shape="rectangle"><solid android:color="@android:color/transparent" /></shape></item>
</selector>
