<?xml version="1.0" encoding="utf-8"?>
<!-- Chosen option in a settings list: a thick ring, dark on a focused (green) row. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true"><shape android:shape="oval"><size android:width="14dp" android:height="14dp" /><solid android:color="@android:color/transparent" /><stroke android:width="4dp" android:color="@color/dash_on_go" /></shape></item>
    <item><shape android:shape="oval"><size android:width="14dp" android:height="14dp" /><solid android:color="@android:color/transparent" /><stroke android:width="4dp" android:color="@color/dash_text" /></shape></item>
</selector>
